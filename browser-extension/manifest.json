{
  "manifest_version": 3,
  "name": "Termorize for Google Translate™",
  "short_name": "Termorize",
  "version": "1.1.0",
  "description": "Translate selected text anywhere and save useful word pairs to Termorize.",
  "homepage_url": "https://termorize.daniil.online",
  "minimum_chrome_version": "102",
  "permissions": ["activeTab", "cookies", "scripting"],
  "host_permissions": [
    "https://translate.google.com/*",
    "https://termorize.daniil.online/*"
  ],
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "background": {
    "service_worker": "background.js"
  },
  "commands": {
    "translate-selection": {
      "suggested_key": {
        "default": "Alt+T"
      },
      "description": "Translate the selected text with Termorize"
    },
    "save-with-editing": {
      "suggested_key": {
        "default": "Ctrl+E"
      },
      "description": "Review the Google Translate word pair before saving"
    },
    "save-without-editing": {
      "suggested_key": {
        "default": "Ctrl+S"
      },
      "description": "Save the Google Translate word pair immediately"
    }
  },
  "content_scripts": [
    {
      "matches": ["https://translate.google.com/*"],
      "js": ["content.js"],
      "css": ["content.css"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    },
    "default_title": "Translate selected text with Termorize"
  }
}
